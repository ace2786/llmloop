# ── 密钥与本地配置（绝不进仓库，第 16 节硬要求）──
.env
.env.*
*.key
secrets.json

# ── Python ──
__pycache__/
*.py[cod]
*.so
.venv/
.venv-*/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── 模型权重（体积大，用脚本重新下载）──
models/*.gguf
models/*.safetensors
models/*.bin
models/*.pt
models/*.pth

# ── 第三方仓库源码（用脚本重新拉）──
data/LlamaFactory-main/
data/*.tar.gz
data/issues/

# ── 大体积中间数据 ──
data/candidates_with_retrieval.json
data/question_candidates.json
data/issue_candidates.json

# ── 编辑器与系统 ──
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ── 日志与临时文件 ──
*.log
tmp/
temp/

# ── 盲判中间产物（打乱顺序 + 代号对照表，判完即失效，无复查价值）──
out/to_grade.csv
out/blind_map.json
out/待判分_*.xlsx

# 判分辅助页（由 scripts/grade_aid.py make 重新生成）
out/grade_*.html

# 注意：以下内容【必须】进仓库（第 11 节第 7 步要求）
#   week1.py / lib/ / scripts/ / configs/
#   data/chunks.jsonl          ← 检索索引，保证别人能复算
#   data/questions.json        ← 60 道题与标准答案
#   data/review_sheet.md       ← 候选核对表
#   out/*.csv                  ← 回答原文与判分，保证数字可复算
